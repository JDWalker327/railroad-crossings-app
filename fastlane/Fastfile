default_platform(:ios)

platform :ios do
  desc "Build the app and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_B64"],
      is_key_content_base64: true
    )

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    unless Spaceship::ConnectAPI::App.find(ENV["BUNDLE_ID"])
      UI.message("App #{ENV['BUNDLE_ID']} not found on App Store Connect - creating it")
      begin
        Spaceship::ConnectAPI::App.create(
          name: ENV["APP_NAME"],
          version_string: "1.0",
          sku: "railroad-crossings",
          primary_locale: "en-US",
          bundle_id: ENV["BUNDLE_ID"],
          platforms: ["IOS"]
        )
      rescue => e
        UI.user_error!("Could not create the app on App Store Connect (#{e.message}). " \
          "Create it manually in App Store Connect > My Apps > New App " \
          "(name: #{ENV['APP_NAME']}, bundle ID: #{ENV['BUNDLE_ID']}, SKU: railroad-crossings, language: English), then re-run.")
      end
    end

    # Reuse the persisted signing identity (created once via the bootstrap
    # lane) so each CI run does not burn a new certificate slot.
    unless ENV["ASC_CERT_P12_B64"].to_s.empty?
      File.binwrite("/tmp/identity.p12", Base64.decode64(ENV["ASC_CERT_P12_B64"]))
      sh("security import /tmp/identity.p12 -k #{ENV['HOME']}/Library/Keychains/login.keychain-db -P #{ENV['ASC_CERT_P12_PASSWORD']} -T /usr/bin/codesign -T /usr/bin/security || true")
    end

    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"])

    # Pods targets must keep automatic signing - let Xcode resolve the app
    # target signing with the App Store Connect API key in the environment.
    gym(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "One-time: create a reusable distribution identity and print it as base64"
  lane :bootstrap do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_B64"],
      is_key_content_base64: true
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # Private keys from previous CI runs were lost with their runners - revoke
    # the now-unusable distribution certificates to free the account slots.
    %w(DISTRIBUTION IOS_DISTRIBUTION).each do |type|
      certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: type })
      UI.message("Revoking #{certs.length} #{type} certificate(s)")
      certs.each(&:delete!)
    end

    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"])

    keychain = "#{ENV['HOME']}/Library/Keychains/login.keychain-db"
    sh("security export -k #{keychain} -t identities -m -P fastpatch -f pkcs12 -o signing_identity.p12")
    UI.message("SIGNING_P12_B64_START")
    UI.message(Base64.strict_encode64(File.binread("signing_identity.p12")))
    UI.message("SIGNING_P12_B64_END")
  end
end
