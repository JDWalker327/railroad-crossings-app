default_platform(:ios)

platform :ios do
  desc "Build the app and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_B64"],
      is_key_content_base64: true
    )

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    unless Spaceship::ConnectAPI::App.find(ENV["BUNDLE_ID"])
      UI.message("App #{ENV['BUNDLE_ID']} not found on App Store Connect - creating it")
      begin
        Spaceship::ConnectAPI::App.create(
          name: ENV["APP_NAME"],
          version_string: "1.0",
          sku: "railroad-crossings",
          primary_locale: "en-US",
          bundle_id: ENV["BUNDLE_ID"],
          platforms: ["IOS"]
        )
      rescue => e
        UI.user_error!("Could not create the app on App Store Connect (#{e.message}). " \
          "Create it manually in App Store Connect > My Apps > New App " \
          "(name: #{ENV['APP_NAME']}, bundle ID: #{ENV['BUNDLE_ID']}, SKU: railroad-crossings, language: English), then re-run.")
      end
    end

    # Import the persisted signing identity (created once via the bootstrap
    # lane) into a dedicated, unlocked keychain with an explicit partition
    # list. Without this, codesign silently blocks on a GUI keychain prompt
    # that never appears on a headless runner (90-min job timeout hang).
    keychain_name = "fastlane-signing.keychain"
    keychain_password = "temp123456"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    File.delete(keychain_path) if File.exist?(keychain_path)
    sh("security create-keychain -p #{keychain_password} #{keychain_path}")
    sh("security unlock-keychain -p #{keychain_password} #{keychain_path}")
    sh("security set-keychain-settings -t 3600 -u #{keychain_path}")
    sh("security list-keychains -d user -s #{keychain_path}")
    sh("security default-keychain -s #{keychain_path}")

    if ENV["ASC_CERT_P12_B64"].to_s.empty?
      UI.message("No persisted identity secret - creating a new one via cert")
      cert(api_key: api_key, keychain_path: keychain_path, keychain_password: keychain_password)
    else
      File.binwrite("/tmp/identity.p12", Base64.decode64(ENV["ASC_CERT_P12_B64"]))
      sh("security import /tmp/identity.p12 -k #{keychain_path} -P #{ENV['ASC_CERT_P12_PASSWORD']} -T /usr/bin/codesign")
    end
    sh("security set-key-partition-list -S apple-tool:,apple: -s -k #{keychain_password} #{keychain_path}")

    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"])

    # Capacitor projects ship without a team - derive it from the imported
    # distribution identity so xcodebuild can resolve signing.
    team_id = \`security find-certificate -c "Apple Distribution" -p | openssl x509 -noout -subject\`[/OU=([A-Z0-9]+)/, 1]
    UI.user_error!("Could not determine the development team from the signing identity") unless team_id
    UI.message("Signing with development team #{team_id}")

    # Switch only the App target to manual signing against the profile sigh
    # downloaded (Pods targets must keep automatic signing without a team).
    require "xcodeproj"
    project = Xcodeproj::Project.open(File.expand_path("../ios/App/App.xcodeproj", __dir__))
    UI.message("Xcode targets: #{project.targets.map(&:name).join(', ')}")
    app_target = project.targets.find { |t| t.name == "App" } || project.targets.find { |t| t.symbol_type == :application }
    UI.user_error!("No application target found in the Xcode project") unless app_target
    UI.message("Patching signing for target #{app_target.name}")
    app_target.build_configurations.each do |config|
      config.build_settings["CODE_SIGN_STYLE"] = "Manual"
      config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
      config.build_settings["DEVELOPMENT_TEAM"] = team_id
      config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = ENV["SIGH_NAME"]
      config.build_settings["PROVISIONING_PROFILE"] = ENV["SIGH_UUID"]
    end
    project.save

    gym(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store"
    )

    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "One-time: create a reusable distribution identity and print it as base64"
  lane :bootstrap do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_B64"],
      is_key_content_base64: true
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # Private keys from previous CI runs were lost with their runners - revoke
    # the now-unusable distribution certificates to free the account slots.
    %w(DISTRIBUTION IOS_DISTRIBUTION).each do |type|
      certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: type })
      UI.message("Revoking #{certs.length} #{type} certificate(s)")
      certs.each(&:delete!)
    end

    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"])

    keychain = "#{ENV['HOME']}/Library/Keychains/login.keychain-db"
    sh("security export -k #{keychain} -t identities -P fastpatch -f pkcs12 -o signing_identity.p12")
    UI.message("SIGNING_P12_B64_START")
    UI.message(Base64.strict_encode64(File.binread("signing_identity.p12")))
    UI.message("SIGNING_P12_B64_END")
  end
end
