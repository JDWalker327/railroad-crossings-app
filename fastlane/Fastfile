default_platform(:ios)

platform :ios do
  desc "Build the app and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_B64"],
      is_key_content_base64: true
    )

    # 'produce' cannot authenticate with App Store Connect API keys
    # (fastlane/fastlane#29435) — ensure the app record via the Connect API
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    unless Spaceship::ConnectAPI::App.find(ENV["BUNDLE_ID"])
      UI.message("App #{ENV['BUNDLE_ID']} not found on App Store Connect — creating it")
      Spaceship::ConnectAPI::App.create(
        name: ENV["APP_NAME"],
        version_string: "1.0",
        sku: "railroad-crossings",
        primary_locale: "en-US",
        bundle_id: ENV["BUNDLE_ID"],
        platforms: ["IOS"]
      )
    end

    cert(api_key: api_key, type: "appstore")
    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"], type: "appstore")

    gym(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      xcargs: "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE='#{ENV['SIGH_UUID']}'"
    )

    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
